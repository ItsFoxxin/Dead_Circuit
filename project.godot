; Open with Godot 4.7.2 stable. See docs/DEVELOPMENT.md.
config_version=5

[application]
config/name="Dead Circuit"
config/version="0.0.6"
run/main_scene="res://game/core/room_bootstrap.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[debug]
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}

restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}

release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

weapon_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}

weapon_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}

weapon_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}

activate_item={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.05, 1)
