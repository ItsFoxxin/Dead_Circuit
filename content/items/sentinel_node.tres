[gd_resource type="Resource" script_class="ItemDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://game/items/item_definition.gd" id="item"]
[ext_resource type="Script" path="res://game/items/item_trigger.gd" id="trigger"]
[ext_resource type="Script" path="res://game/items/item_condition.gd" id="condition"]
[ext_resource type="Script" path="res://game/items/item_effect.gd" id="effect"]
[ext_resource type="Resource" path="res://content/factions/scrapborn.tres" id="faction"]

[sub_resource type="Resource" id="Any"]
script = ExtResource("condition")

[sub_resource type="Resource" id="Drone"]
script = ExtResource("effect")
kind = 10
amount = 8.0
radius = 12.0
attacks_per_second = 1.0

[sub_resource type="Resource" id="Acquire"]
script = ExtResource("trigger")
event = 5
condition = SubResource("Any")
effects = Array[ExtResource("effect")]([SubResource("Drone")])

[resource]
script = ExtResource("item")
id = &"sentinel_node"
display_name = "Sentinel Node"
description = "Deploys a hovering drone that attacks a nearby enemy once per second for 8 base damage."
flavor_text = "Recovered, repaired, and only occasionally hostile."
faction = ExtResource("faction")
classification = &"autonomous_system"
tags = PackedStringArray("offense", "companion")
triggers = Array[ExtResource("trigger")]([SubResource("Acquire")])
