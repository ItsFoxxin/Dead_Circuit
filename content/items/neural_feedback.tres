[gd_resource type="Resource" script_class="ItemDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://game/items/item_definition.gd" id="item"]
[ext_resource type="Script" path="res://game/items/item_trigger.gd" id="trigger"]
[ext_resource type="Script" path="res://game/items/item_condition.gd" id="condition"]
[ext_resource type="Script" path="res://game/items/item_effect.gd" id="effect"]
[ext_resource type="Resource" path="res://content/factions/null_choir.tres" id="faction"]

[sub_resource type="Resource" id="Any"]
script = ExtResource("condition")

[sub_resource type="Resource" id="Feedback"]
script = ExtResource("effect")
kind = 3
amount = 1.2
duration = 4.0
stat = &"fire_rate"

[sub_resource type="Resource" id="Damaged"]
script = ExtResource("trigger")
event = 4
condition = SubResource("Any")
effects = Array[ExtResource("effect")]([SubResource("Feedback")])

[resource]
script = ExtResource("item")
id = &"neural_feedback"
display_name = "Neural Feedback"
description = "Actual HP damage grants +20% attack speed for 4 seconds; damage refreshes it."
flavor_text = "Trauma response converted into combat efficiency."
faction = ExtResource("faction")
classification = &"neural_augmentation"
tags = PackedStringArray("offense", "reactive")
triggers = Array[ExtResource("trigger")]([SubResource("Damaged")])
